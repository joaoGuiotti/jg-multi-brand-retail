# ==============================================================================
# CONFIGURAÇÃO DE PRODUÇÃO - VARIÁVEIS DE AMBIENTE (.env.prod)
# jg-multi-brand-retail - Fase 3: Infraestrutura, Docker & Backup
# ==============================================================================
# Copie este arquivo para .env.prod e configure os valores adequados:
#   cp .env.prod.example .env.prod
# Para executar o stack de produção:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# NUNCA comite o arquivo .env.prod no controle de versão!
# ==============================================================================

# [OBRIGATÓRIO] Banco de Dados PostgreSQL - Aplicação (role retail_app sem BYPASSRLS)
DB_VENDOR=postgresql
DB_HOST=db
DB_PORT=5432
DB_NAME=retail_saas
DB_USER=retail_app
DB_PASSWORD=your_secure_retail_app_password

# [OBRIGATÓRIO] Banco de Dados PostgreSQL - Migrador/Owner (role com BYPASSRLS e DDL)
MIGRATION_DB_USER=postgres
MIGRATION_DB_PASSWORD=your_super_secure_postgres_root_password

# [OBRIGATÓRIO] Redis (Cache & BullMQ)
REDIS_PASSWORD=your_secure_redis_password_prod

# [OBRIGATÓRIO] Autenticação JWT (chaves distintas de 64+ caracteres aleatórios)
JWT_SECRET=generate_a_very_long_random_secret_for_production_jwt_access
JWT_REFRESH_SECRET=generate_another_very_long_random_secret_for_production_refresh
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# [OBRIGATÓRIO] Frontend URL (usado para CORS e links de redefinição de senha)
FRONTEND_URL=https://app.seudominio.com.br
CORS_ORIGIN=https://app.seudominio.com.br

# [OBRIGATÓRIO] Backup Criptografado & Retenção
BACKUP_ENCRYPTION_KEY=generate_a_very_strong_aes256_encryption_key_for_backups
BACKUP_RETENTION_DAYS=7
# Opcional: Bucket S3 / MinIO para armazenamento offsite de backups
S3_BUCKET=s3://meu-bucket-backups-retail

# [OPCIONAL / CONFIGURÁVEL] Aplicação Backend
NODE_ENV=production
PORT=3000

# [OPCIONAL] SMTP / Envio de Emails (SendGrid, Amazon SES, Mailgun, etc.)
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USER=apikey
MAIL_PASS=sua_chave_smtp_producao
MAIL_FROM="Retail SaaS <no-reply@seudominio.com.br>"

# [OPCIONAL] Rate Limiting & Upload
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
MAX_FILE_SIZE=5242880
