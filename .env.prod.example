# ==============================================================================
# CONFIGURAÇÃO DE PRODUÇÃO - VARIÁVEIS DE AMBIENTE
# ==============================================================================
# Copie este arquivo para .env.prod e configure os valores adequados:
#   cp .env.prod.example .env.prod
# Para executar o stack de produção:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# NÃO comite o arquivo .env.prod no controle de versão.
# ==============================================================================

# [OBRIGATÓRIO] Banco de Dados PostgreSQL
# ATENÇÃO: Se DB_PASSWORD contiver caracteres especiais (@, :, /, #), 
# utilize apenas caracteres alfanuméricos ou codifique em URL-encode.
DB_VENDOR=postgresql
DB_HOST=db
DB_PORT=5432
DB_NAME=retail_saas
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_password
# DB_URL e DATABASE_URL são montadas automaticamente pelo compose a partir das variáveis acima

# [OBRIGATÓRIO] Autenticação JWT
JWT_SECRET=generate_a_very_long_random_secret_for_production
JWT_REFRESH_SECRET=generate_another_very_long_random_secret_for_production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# [OBRIGATÓRIO] Frontend URL (usado para CORS e links de redefinição de senha)
FRONTEND_URL=http://localhost

# [OPCIONAL / CONFIGURÁVEL] Aplicação Backend
NODE_ENV=production
PORT=3000
CORS_ORIGIN=http://localhost

# [OPCIONAL] SMTP / Envio de Emails (ex: Mailpit, SendGrid, Amazon SES)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Retail SaaS <no-reply@retailsaas.com>"

# [OPCIONAL] Rate Limiting & Upload
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
MAX_FILE_SIZE=5242880
