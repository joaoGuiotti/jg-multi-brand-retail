// This is your Prisma schema file
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =====================================================================
// NOTAS DE ARQUITETURA (multi-tenant)
// ---------------------------------------------------------------------
// * Toda tabela de negócio carrega `tenant_id` (TEXT, uuid em string).
// * `@@unique([tenantId, id])` nos "pais" + FKs COMPOSTAS `[tenantId, xId] ->
//   [tenantId, id]` impedem, no banco, que uma linha do tenant A aponte para
//   um registro do tenant B (integridade cross-tenant).
// * Relações opcionais com FK composta usam `onDelete: Restrict` (o Prisma não
//   permite SetNull quando `tenantId` é NOT NULL e faz parte da FK).
// * `User.email` é @unique GLOBAL de propósito: o login é feito somente por
//   e-mail e um usuário pertence a exatamente UM tenant (ver README).
// * CHECKs, RLS, roles e as FKs compostas estão em migrations SQL manuais
//   (apps/backend/prisma/migrations/*), pois o Prisma não os expressa.
// =====================================================================

// =====================
// CORE ENTITIES
// =====================

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  logoUrl        String?  @map("logo_url")
  commissionRate Decimal? @map("commission_rate") @db.Decimal(5, 2)
  settings       Json?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users                   User[]
  products                Product[]
  categories              Category[]
  brands                  Brand[]
  suppliers               Supplier[]
  sales                   Sale[]
  saleItems               SaleItem[]
  payments                Payment[]
  conditionals            Conditional[]
  conditionalItems        ConditionalItem[]
  inventory               InventoryMovement[]
  auditLogs               AuditLog[]
  customers               Customer[]
  passwordResetTokens     PasswordResetToken[]
  refreshTokens           RefreshToken[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  returnOrders            ReturnOrder[]
  returnItems             ReturnItem[]
  loyaltyProgram          LoyaltyProgram?
  loyaltyAccounts         LoyaltyAccount[]
  loyaltyTransactions    LoyaltyTransaction[]
  financialAccounts       FinancialAccount[]
  salesTargets            SalesTarget[]
  commissions             CommissionTransaction[]

  @@map("tenants")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

model User {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  /// Único GLOBAL (decisão de design): login só por e-mail; 1 usuário => 1 tenant.
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  name         String
  active       Boolean  @default(true)
  /// Segredo TOTP cifrado em repouso (AES-256-GCM, formato `v1:iv:tag:ciphertext`).
  twoFaSecret  String?  @map("two_fa_secret")
  twoFaEnabled Boolean  @default(false) @map("two_fa_enabled")
  /// Somente HASHES (SHA-256) dos códigos de backup; nunca o código em claro.
  twoFaBackupCodes String[] @default([]) @map("two_fa_backup_codes")
  tokenVersion Int      @default(1) @map("token_version")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(3)
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant                  Tenant                   @relation(fields: [tenantId], references: [id])
  sales                   Sale[]
  conditionals            Conditional[]
  inventory               InventoryMovement[]
  auditLogs               AuditLog[]
  passwordResetTokens     PasswordResetToken[]
  refreshTokens           RefreshToken[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  createdReturns          ReturnOrder[]            @relation("CreatedReturns")
  approvedReturns         ReturnOrder[]            @relation("ApprovedReturns")
  salesTargets            SalesTarget[]
  commissions             CommissionTransaction[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("users")
}

// =====================
// PRODUCT  MANAGEMENT
// =====================

model Category {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  parentId  String?  @map("parent_id")
  createdAt DateTime @default(now()) @map("created_at")

  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@index([tenantId])
  @@map("categories")
}

model Brand {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  products Product[]

  @@index([tenantId])
  @@map("brands")
}

model Supplier {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  document  String?
  contact   String?
  createdAt DateTime @default(now()) @map("created_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  products Product[]

  @@index([tenantId])
  @@map("suppliers")
}

model Product {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  name          String
  description   String?
  sku           String
  barcode       String?
  categoryId    String?  @map("category_id")
  brandId       String?  @map("brand_id")
  supplierId    String?  @map("supplier_id")
  costPrice     Decimal  @map("cost_price") @db.Decimal(10, 2)
  salePrice     Decimal  @map("sale_price") @db.Decimal(10, 2)
  margin        Decimal  @db.Decimal(10, 2)
  /// CHECK (stock_quantity >= 0) na migration 20261009100005.
  stockQuantity Int      @default(0) @map("stock_quantity")
  /// Limitação documentada: quantidades são Int (venda somente por unidade
  /// inteira). `unit` é validado contra uma lista permitida na camada de domínio.
  unit          String   @default("UN")
  active        Boolean  @default(true)
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant           Tenant              @relation(fields: [tenantId], references: [id])
  category         Category?           @relation(fields: [categoryId], references: [id])
  brand            Brand?              @relation(fields: [brandId], references: [id])
  supplier         Supplier?           @relation(fields: [supplierId], references: [id])
  saleItems        SaleItem[]
  conditionalItems ConditionalItem[]
  inventory        InventoryMovement[]
  returnItems      ReturnItem[]

  @@unique([tenantId, sku])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([barcode])
  @@map("products")
}

// =====================
// SALES
// =====================

enum SaleStatus {
  PENDING
  COMPLETED
  RETURN_REQUESTED
  RETURNED
  CANCELLED
}

model Sale {
  id            String     @id @default(uuid())
  tenantId      String     @map("tenant_id")
  userId        String     @map("user_id")
  customerId    String?    @map("customer_id")
  invoiceNumber String?    @map("invoice_number")
  subtotal      Decimal    @db.Decimal(10, 2)
  discount      Decimal    @default(0) @db.Decimal(10, 2)
  /// CHECK (total = subtotal - discount AND total >= 0) na migration 20261009100005.
  total         Decimal    @db.Decimal(10, 2)
  status        SaleStatus @default(PENDING)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  user         User          @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)
  customer     Customer?     @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  items        SaleItem[]
  payments     Payment[]
  returnOrders ReturnOrder[]
  loyaltyTransactions LoyaltyTransaction[]
  financialAccounts FinancialAccount[]
  commissionTransaction CommissionTransaction?

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([createdAt])
  @@map("sales")
}

model SaleItem {
  id        String  @id @default(uuid())
  tenantId  String  @map("tenant_id")
  saleId    String  @map("sale_id")
  productId String  @map("product_id")
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)
  discount  Decimal @default(0) @db.Decimal(10, 2)
  total     Decimal @db.Decimal(10, 2)
  costPriceAtSale Decimal? @map("cost_price_at_sale") @db.Decimal(10, 2)

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  sale    Sale    @relation(fields: [tenantId, saleId], references: [tenantId, id], onDelete: Cascade)
  product Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  returnItems ReturnItem[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([saleId])
  @@map("sale_items")
}

// =====================
// PAYMENTS
// =====================

enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  CASH
  BOLETO
  STORE_CREDIT
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
}

model Payment {
  id           String        @id @default(uuid())
  tenantId     String        @map("tenant_id")
  saleId       String        @map("sale_id")
  method       PaymentMethod
  amount       Decimal       @db.Decimal(10, 2)
  installments Int           @default(1)
  fee          Decimal       @default(0) @db.Decimal(10, 2)
  status       PaymentStatus @default(PENDING)
  paidAt       DateTime?     @map("paid_at")
  metadata     Json?
  createdAt    DateTime      @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  sale   Sale   @relation(fields: [tenantId, saleId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId])
  @@index([saleId])
  @@map("payments")
}

// =====================
// CONDITIONALS
// =====================

enum ConditionalStatus {
  ACTIVE
  RETURNED
  CONVERTED
}

model Conditional {
  id              String            @id @default(uuid())
  tenantId        String            @map("tenant_id")
  userId          String            @map("user_id")
  customerId      String?           @map("customer_id")
  status          ConditionalStatus @default(ACTIVE)
  dueDate         DateTime?         @map("due_date")
  createdAt       DateTime          @default(now()) @map("created_at")
  returnedAt      DateTime?         @map("returned_at")
  convertedAt     DateTime?         @map("converted_at")
  convertedSaleId String?           @map("converted_sale_id")

  tenant   Tenant            @relation(fields: [tenantId], references: [id])
  user     User              @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)
  customer Customer?         @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  items    ConditionalItem[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([status])
  @@map("conditionals")
}

model ConditionalItem {
  id            String  @id @default(uuid())
  tenantId      String  @map("tenant_id")
  conditionalId String  @map("conditional_id")
  productId     String  @map("product_id")
  quantity      Int
  unitPrice     Decimal @map("unit_price") @db.Decimal(10, 2)

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  conditional Conditional @relation(fields: [tenantId, conditionalId], references: [tenantId, id], onDelete: Cascade)
  product     Product     @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId])
  @@index([conditionalId])
  @@map("conditional_items")
}

// =====================
// INVENTORY
// =====================

enum MovementType {
  ENTRY
  EXIT
  ADJUSTMENT
  RETURN
}

model InventoryMovement {
  id        String       @id @default(uuid())
  tenantId  String       @map("tenant_id")
  productId String       @map("product_id")
  userId    String       @map("user_id")
  type      MovementType
  /// CHECK (quantity > 0) na migration 20261009100005.
  quantity  Int
  reference String?
  createdAt DateTime     @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  product Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  user    User    @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId])
  @@index([productId])
  @@map("inventory_movements")
}

// =====================
// AUDIT
// =====================

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

model AuditLog {
  id         String      @id @default(uuid())
  tenantId   String      @map("tenant_id")
  userId     String      @map("user_id")
  entityType String      @map("entity_type")
  entityId   String      @map("entity_id")
  action     AuditAction
  changes    Json?
  createdAt  DateTime    @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// =====================
// CUSTOMERS
// =====================

model Customer {
  id        String  @id @default(uuid())
  tenantId  String  @map("tenant_id")
  firstName String  @map("first_name")
  lastName  String  @map("last_name")
  email     String
  phone     String
  isActive  Boolean @default(true) @map("is_active")
  /// CPF/CNPJ somente dígitos (normalizado e validado no domínio). NULL = sem
  /// documento (vários por tenant). Único POR TENANT (e não mais global).
  document  String? @map("document") @db.VarChar(14)

  // Address (flattened from Address VO)
  street     String
  number     String
  complement String?
  city       String
  state      String
  zipCode    String  @map("zip_code")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  conditionals Conditional[]
  sales        Sale[]
  returnOrders ReturnOrder[]
  loyaltyAccount LoyaltyAccount?

  @@unique([tenantId, document])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([email])
  @@map("customers")
}

// =====================
// AUTH — PASSWORD RESET
// =====================

model PasswordResetToken {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@map("password_reset_tokens")
}

// =====================
// AUTH — REFRESH TOKENS (opacos, rotativos, com detecção de reuso)
// =====================

model RefreshToken {
  id                String    @id @default(uuid())
  tenantId          String    @map("tenant_id")
  userId            String    @map("user_id")
  /// SHA-256 (hex) do token opaco. O token em claro nunca é persistido.
  tokenHash         String    @unique @map("token_hash")
  /// Todos os tokens derivados do mesmo login compartilham a família; reuso
  /// de um token já rotacionado/revogado revoga a família inteira.
  familyId          String    @map("family_id")
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedByTokenId String?   @map("replaced_by_token_id")
  userAgent         String?   @map("user_agent")
  ip                String?
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// =====================
// NOTIFICATIONS
// =====================

enum NotificationType {
  LOW_STOCK
  OUT_OF_STOCK
  GOAL_ACHIEVED
  RETURN_PENDING
  RETURN_APPROVED
  RETURN_REJECTED
  RETURN_REFUNDED
  PROMOTION_EXPIRING
  SALE_COMPLETED
  COMMISSION_CALCULATED
  SYSTEM
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Notification {
  id        String               @id @default(uuid())
  tenantId  String               @map("tenant_id")
  userId    String               @map("user_id")
  type      NotificationType
  priority  NotificationPriority @default(MEDIUM)
  title     String
  message   String
  data      Json?
  actionUrl String?              @map("action_url")
  readAt    DateTime?            @map("read_at")
  createdAt DateTime             @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId, readAt])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id       String           @id @default(uuid())
  tenantId String           @map("tenant_id")
  userId   String           @map("user_id")
  type     NotificationType
  enabled  Boolean          @default(true)
  sound    Boolean          @default(true)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, type])
  @@map("notification_preferences")
}

// =====================
// RETURNS & EXCHANGES (RMA)
// =====================

enum ReturnStatus {
  REQUESTED
  APPROVED
  REFUNDED
  REJECTED
}

enum RefundType {
  STORE_CREDIT
  CASH_REFUND
  EXCHANGE
}

enum ReturnItemCondition {
  GOOD
  DAMAGED
  DEFECTIVE
}

model ReturnOrder {
  id          String       @id @default(uuid())
  tenantId    String       @map("tenant_id")
  saleId      String       @map("sale_id")
  userId      String       @map("user_id")
  customerId  String?      @map("customer_id")
  status      ReturnStatus @default(REQUESTED)
  refundType  RefundType   @map("refund_type")
  reason      String?
  totalRefund Decimal      @map("total_refund") @db.Decimal(10, 2)
  approvedBy  String?      @map("approved_by")
  approvedAt  DateTime?    @map("approved_at")
  processedAt DateTime?    @map("processed_at")
  createdAt   DateTime     @default(now()) @map("created_at")

  tenant   Tenant       @relation(fields: [tenantId], references: [id])
  sale     Sale         @relation(fields: [tenantId, saleId], references: [tenantId, id], onDelete: Restrict)
  user     User         @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict, name: "CreatedReturns")
  approver User?        @relation(fields: [tenantId, approvedBy], references: [tenantId, id], onDelete: Restrict, name: "ApprovedReturns")
  customer Customer?    @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  items    ReturnItem[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([saleId])
  @@map("return_orders")
}

model ReturnItem {
  id            String              @id @default(uuid())
  tenantId      String              @map("tenant_id")
  returnOrderId String              @map("return_order_id")
  productId     String              @map("product_id")
  /// Item da venda original que está sendo devolvido. NULL apenas em dados
  /// legados cujo backfill foi ambíguo (reportado na migration).
  saleItemId    String?             @map("sale_item_id")
  quantity      Int
  unitPrice     Decimal             @map("unit_price") @db.Decimal(10, 2)
  total         Decimal             @db.Decimal(10, 2)
  condition     ReturnItemCondition @default(GOOD)

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  returnOrder ReturnOrder  @relation(fields: [tenantId, returnOrderId], references: [tenantId, id], onDelete: Cascade)
  product     Product      @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  saleItem    SaleItem?    @relation(fields: [tenantId, saleItemId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId])
  @@index([returnOrderId])
  @@index([saleItemId])
  @@map("return_items")
}

// ==========================================
// PROGRAMA DE FIDELIDADE & CASHBACK (SPRINT 3)
// ==========================================

model LoyaltyProgram {
  id              String   @id @default(uuid())
  tenantId        String   @unique @map("tenant_id")
  name            String   @default("Programa de Fidelidade")
  pointsPerReal   Decimal  @default(1.00) @map("points_per_real") @db.Decimal(10, 2)
  redeemRatio     Decimal  @default(0.0100) @map("redeem_ratio") @db.Decimal(10, 4)
  minRedeemPoints Int      @default(100) @map("min_redeem_points")
  maxDiscountPct  Decimal  @default(50.00) @map("max_discount_pct") @db.Decimal(5, 2)
  expirationDays  Int?     @map("expiration_days") // v1: Sempre nulo (Never Expire)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant   Tenant           @relation(fields: [tenantId], references: [id])
  accounts LoyaltyAccount[]

  @@map("loyalty_programs")
}

model LoyaltyAccount {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  customerId       String   @unique @map("customer_id")
  loyaltyProgramId String   @map("loyalty_program_id")
  /// CHECK (balance >= 0) na migration 20261009100005.
  balance          Int      @default(0)
  totalEarned      Int      @default(0) @map("total_earned")
  totalRedeemed    Int      @default(0) @map("total_redeemed")
  createdAt        DateTime @default(now()) @map("created_at")

  tenant         Tenant               @relation(fields: [tenantId], references: [id])
  customer       Customer             @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  loyaltyProgram LoyaltyProgram       @relation(fields: [loyaltyProgramId], references: [id])
  transactions   LoyaltyTransaction[]

  @@unique([tenantId, customerId])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("loyalty_accounts")
}

enum LoyaltyTransactionType {
  EARN
  REDEEM
  ADJUST
}

model LoyaltyTransaction {
  id        String                 @id @default(uuid())
  tenantId  String                 @map("tenant_id")
  accountId String                 @map("account_id")
  type      LoyaltyTransactionType
  points    Int                    // Positivo para EARN/ADJUST, Negativo para REDEEM/ADJUST (débito)
  saleId    String?                @map("sale_id")
  reason    String?                @db.Text // Justificativa obrigatória para ADJUST
  createdAt DateTime               @default(now()) @map("created_at")

  tenant  Tenant         @relation(fields: [tenantId], references: [id])
  account LoyaltyAccount @relation(fields: [tenantId, accountId], references: [tenantId, id], onDelete: Restrict)
  sale    Sale?          @relation(fields: [tenantId, saleId], references: [tenantId, id], onDelete: Restrict)

  /// Idempotência por venda: no máximo 1 EARN, 1 REDEEM e 1 ADJUST (estorno)
  /// por (conta, venda). Em PostgreSQL NULLs são distintos em índices únicos,
  /// portanto ajustes manuais (saleId NULL) nunca conflitam entre si.
  @@unique([accountId, saleId, type])
  @@index([accountId])
  @@index([tenantId])
  @@map("loyalty_transactions")
}

// =====================
// FINANCE
// =====================

enum FinancialAccountType {
  PAYABLE
  RECEIVABLE
}

enum FinancialAccountStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

model FinancialAccount {
  id          String                 @id @default(uuid())
  tenantId    String                 @map("tenant_id")
  type        FinancialAccountType
  description String
  amount      Decimal                @db.Decimal(10, 2)
  dueDate     DateTime               @map("due_date")
  paidAt      DateTime?              @map("paid_at")
  status      FinancialAccountStatus @default(PENDING)
  category    String
  saleId      String?                @map("sale_id")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  sale   Sale?  @relation(fields: [tenantId, saleId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId])
  @@index([saleId])
  @@map("financial_accounts")
}

// =====================
// COMMISSIONS (SPRINT 4)
// =====================

model SalesTarget {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  userId       String   @map("user_id")
  month        Int
  year         Int
  targetAmount Decimal  @map("target_amount") @db.Decimal(10, 2)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([tenantId, userId, month, year])
  @@index([tenantId])
  @@index([userId])
  @@map("sales_targets")
}

enum CommissionStatus {
  PENDING
  PAID
  REVERSED
}

model CommissionTransaction {
  id                String           @id @default(uuid())
  tenantId          String           @map("tenant_id")
  userId            String           @map("user_id")
  saleId            String           @unique @map("sale_id")
  baseAmount        Decimal          @map("base_amount") @db.Decimal(10, 2)
  percentageApplied Decimal          @map("percentage_applied") @db.Decimal(5, 2)
  commissionAmount  Decimal          @map("commission_amount") @db.Decimal(10, 2)
  status            CommissionStatus @default(PENDING)
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)
  sale   Sale   @relation(fields: [tenantId, saleId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, saleId])
  @@index([tenantId])
  @@index([userId])
  @@map("commission_transactions")
}
