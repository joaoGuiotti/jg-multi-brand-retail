{
  "name": "frontend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/frontend/src",
  "implicitDependencies": ["ui"],
  "targets": {
    "build": {
      "command": "npm run build",
      "options": {
        "cwd": "apps/frontend"
      },
      "outputs": ["{workspaceRoot}/apps/frontend/dist"],
      "cache": true
    },
    "serve": {
      "command": "npm run start",
      "options": {
        "cwd": "apps/frontend",
        "proxyConfig": "apps/frontend/proxy.conf.json"
      }
    },
    "start": {
      "command": "npm run start",
      "options": {
        "cwd": "apps/frontend"
      }
    },
    "test": {
      "command": "npm run test",
      "options": {
        "cwd": "apps/frontend"
      },
      "cache": true
    },
    "test:cov": {
      "command": "npm run test:cov",
      "options": {
        "cwd": "apps/frontend"
      },
      "outputs": ["{workspaceRoot}/apps/frontend/coverage"],
      "cache": true
    }
  }
}
