{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ES2022",
        "moduleResolution": "node",
        "experimentalDecorators": true,
        "strict": true,
        "skipLibCheck": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "lib": [
            "ES2022",
            "dom"
        ],
        "paths": {
            "@angular/*": [
                "../../../node_modules/@angular/*"
            ],
            "rxjs": [
                "../../../node_modules/rxjs"
            ],
            "rxjs/*": [
                "../../../node_modules/rxjs/*"
            ]
        }
    },
    "include": [
        "src/**/*.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}