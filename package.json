{
  "name": "retail-saas-monorepo",
  "version": "1.0.0",
  "description": "Multi-Brand Retail SaaS Platform",
  "private": true,
  "scripts": {
    "start": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd apps/backend && npm run start:dev",
    "dev:frontend": "cd apps/frontend && npm start",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd apps/backend && npm run build",
    "build:frontend": "cd apps/frontend && npm run build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "migrate": "cd apps/backend && npx prisma migrate dev",
    "seed": "cd apps/backend && npx prisma db seed",
    "test": "echo \"Run tests in apps\"",
    "lint": "echo \"Run linters in apps\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}