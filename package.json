{
  "name": "retail-saas-monorepo",
  "version": "1.0.0",
  "description": "Multi-Brand Retail SaaS Platform",
  "private": true,
  "scripts": {
    "nx": "nx",
    "start": "concurrently -k -p \"[{name}]\" -n \"Backend,Frontend\" -c \"blue.bold,magenta.bold\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "nx serve backend",
    "dev:frontend": "nx serve frontend",
    "build": "nx run-many -t build",
    "build:backend": "nx build backend",
    "build:frontend": "nx build frontend",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "graph": "nx graph",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "generate": "nx run backend:prisma:generate",
    "migrate": "nx run backend:prisma:migrate",
    "seed": "nx run backend:prisma:seed"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nx": "^23.3.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
